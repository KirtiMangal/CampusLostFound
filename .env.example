# Copy to .env for Docker Compose; this file contains placeholders only.
FRONTEND_PORT=8080
CLIENT_URL=http://localhost:8080
VITE_API_URL=/api
TRUST_PROXY=1

# Set these to your MongoDB Atlas (or other MongoDB) deployment.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/campus-lost-found?retryWrites=true&w=majority
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-bytes
JWT_EXPIRES_IN=1d

# Optional integrations; keep real values only in your local .env/runtime environment.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

MATCH_HEURISTIC_THRESHOLD=45
MATCH_CANDIDATE_POOL_LIMIT=200
MATCH_CANDIDATE_LIMIT=10
MATCH_HEURISTIC_WEIGHT=0.4
MATCH_GEMINI_WEIGHT=0.6
MATCH_GENERATION_LIMIT=5
MATCH_GENERATION_WINDOW_MS=900000
MATCH_STRONG_THRESHOLD=80
MATCH_POSSIBLE_THRESHOLD=60
MATCH_WEAK_THRESHOLD=40
MODERATION_AUTO_FLAG_THRESHOLD=70
